# job.env - one per video, next to the scene script. Read by kitjob.py (scene, captions) and by box/job.sh (render scripts).
# Plain KEY=VALUE lines, no quotes. A variable that is already set in the environment wins over this file.
NAME=cara_kerja_kolam_renang_id_v1     # output names: $NAME.mp4 and ${NAME}_clean_master.mp4
SCENE=pool_video.py                    # the scene script
LANG_CODE=id                           # id | en: language of the narration (transcription, QA)
CAPTION_STYLE=cards                    # cards (1-2 words, key words yellow) | phrases (2-4 words filling in)
FPS=30
OFFSET=0.30                            # seconds of silence before the voice-over starts
TAIL=1.6                               # seconds after the last word (video #2 used 1.62)
SPP=64                                 # Cycles samples
PROCS=3                                # parallel render processes on one GPU
